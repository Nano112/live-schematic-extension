{
  "name": "live-schematic-extension",
  "displayName": "Live Schematic Viewer",
  "description": "Hot-reloading viewer for Minecraft .schem / .litematic / .nbt / .mcstructure files. Powered by Nucleation.",
  "version": "0.1.0",
  "publisher": "Nano112",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nano112/live-schematic-extension.git"
  },
  "icon": "media/icon.png",
  "categories": ["Visualization", "Other"],
  "keywords": [
    "minecraft",
    "schematic",
    "litematic",
    "mcstructure",
    "nbt",
    "viewer",
    "three.js",
    "nucleation"
  ],
  "engines": { "vscode": "^1.85.0" },
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.schem",
    "workspaceContains:**/*.litematic",
    "workspaceContains:**/*.nbt",
    "workspaceContains:**/*.mcstructure"
  ],
  "contributes": {
    "commands": [
      { "command": "liveSchematic.open", "title": "Live Schematic: Open Viewer" },
      { "command": "liveSchematic.setResourcePack", "title": "Live Schematic: Set Resource Pack…" },
      { "command": "liveSchematic.openSettings", "title": "Live Schematic: Open Settings" }
    ],
    "customEditors": [
      {
        "viewType": "liveSchematic.viewer",
        "displayName": "Live Schematic Viewer",
        "selector": [
          { "filenamePattern": "*.schem" },
          { "filenamePattern": "*.litematic" },
          { "filenamePattern": "*.nbt" },
          { "filenamePattern": "*.mcstructure" }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Live Schematic Viewer",
      "properties": {
        "liveSchematic.resourcePack": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a Minecraft resource pack zip or vanilla client .jar. Required to render textured meshes."
        },
        "liveSchematic.extraResourcePacks": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional resource pack paths layered on top of the base pack (later entries win, like Minecraft load order)."
        },
        "liveSchematic.backgroundColor": {
          "type": "string",
          "default": "",
          "description": "Background color (CSS hex, e.g. '#1a1a2e'). Empty = match VSCode editor background."
        },
        "liveSchematic.gridEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show ground grid by default."
        },
        "liveSchematic.gridSize": {
          "type": "number",
          "default": 32,
          "description": "Grid extent in world units."
        },
        "liveSchematic.axesEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show XYZ axes helper by default."
        },
        "liveSchematic.statsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Show FPS / draw-call stats overlay by default."
        },
        "liveSchematic.tickMs": {
          "type": "number",
          "default": 50,
          "description": "Animated-texture tick duration in ms (Minecraft = 50)."
        },
        "liveSchematic.autoFrameOnReload": {
          "type": "boolean",
          "default": false,
          "description": "Re-frame the camera every reload. Off = preserve user camera."
        },
        "liveSchematic.excludeGlobs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/node_modules/**", "**/.git/**", "**/dist/**", "**/out/**"],
          "description": "Glob patterns to exclude when scanning the workspace for schematic files."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "vsce package",
    "vscode:prepublish": "node esbuild.config.js --production"
  },
  "dependencies": {
    "nucleation": "^0.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.184.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "three": "^0.184.0",
    "typescript": "^5.4.0"
  }
}
